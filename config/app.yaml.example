# niuma-cloud 运行配置（复制为 app.yaml 后按环境修改；app.yaml 勿提交）
# 仅 CONFIG_DIR 环境变量可覆盖配置目录，默认 ./config

# HTTP 监听地址。生产只绑本机，由 Nginx 反代 443；勿把 8090 暴露公网
http_addr: "127.0.0.1:8090"
# 前后端单次请求读写超时（分钟），默认 30；流水线上传安装包需要
http_timeout_min: 30
# 是否信任反代的 X-Real-IP / X-Forwarded-For 末跳（生产 Nginx 后保持 true）
trust_proxy: true

# 数据库（生产使用 mysql；sqlite 仅本地临时调试）
db:
  # 驱动：mysql | sqlite
  driver: mysql
  # MySQL DSN：user:pass@tcp(host:port)/dbname?parseTime=true&charset=utf8mb4&loc=UTC
  # 可用环境变量 NIUMA_DB_DSN 覆盖。生产用内网 + 最小权限账号，勿对公网开放 3306
  dsn: "niuma:CHANGE_ME@tcp(127.0.0.1:3306)/niuma_cloud?parseTime=true&charset=utf8mb4&loc=UTC"

# JWT / 会话签发
jwt:
  # 签名密钥，至少 16 字符；含 change-me / dev-niuma / example 时拒绝启动
  # 生产优先环境变量 NIUMA_JWT_SECRET
  secret: "change-me-to-a-long-random-secret"

# 封装上游 API 密钥（与 JWT 分离更稳妥）。空则回退 jwt.secret；已有密文仍可用 JWT 解开
# 生产优先环境变量 NIUMA_CRYPTO_SECRET
# crypto:
#   secret: ""
  # Access Token 有效期（分钟）
  access_token_ttl_min: 30
  # Refresh Token 有效期（天）
  refresh_token_ttl_days: 30

# 允许的浏览器跨域来源（Admin / 官网 / 桌面本地调试）
# 生产同域 www.niuma007.com 时路径为 /niuma/cloud、/niuma/ops
cors_origins:
  - http://localhost:5174
  - http://localhost:5173
  - http://127.0.0.1:5173
  - https://www.niuma007.com
  - https://niuma007.com

# 首次启动若库中无员工账号则种子创建（已存在则跳过）
# 仅库中无员工时种子创建。已有账号改这里无效，请在 Ops 改密。
# 也可用 NIUMA_STAFF_PASSWORD
staff:
  email: admin@niuma007.com
  password: ChangeMeAdmin1!

# SMTP；host 留空时验证码只写日志（开发）
# 阿里云企业邮推荐：host=smtp.mxhichina.com（或 smtp.qiye.aliyun.com）port=465
smtp:
  host: ""
  port: 465
  user: ""
  # 可用 NIUMA_SMTP_PASSWORD 覆盖，避免授权码长期躺在 yaml
  password: ""
  # 发件人地址（须与授权账号一致或为其别名）
  from: noreply@niuma007.com
  # true：无 SMTP 时 Info 打完整验证码。生产必须 false（未写时默认 false）
  log_otp: false

# 邮箱验证码策略
otp:
  # 验证码有效期（分钟）
  ttl_min: 5
  # 同一邮箱同一用途两次发送最小间隔（秒）
  cooldown_sec: 60
  # 同一邮箱每日最多发送次数
  daily_limit: 20

# 用户反馈
feedback:
  # 可选：新反馈时 POST 通知的 Webhook URL
  webhook_url: ""

# 桌面应用内更新：download_url 域名约束；流水线落盘后地址为本站
# 官网 / 投放请用稳定入口 /api/v1/updates/download（点击时解析最新 published）
# 空列表=仅禁 http/内网/IP（开发）；生产务必含官方域名
updates:
  public_base: "https://www.niuma007.com/niuma/cloud"
  # 安装包目录，默认 {data_dir}/releases
  dir: ""
  # 单个安装包上限（MB）
  max_file_mb: 2048
  download_url_hosts:
    - niuma007.com
    - www.niuma007.com
    # - cdn.niuma007.com

# GitHub Actions 等流水线：先上传安装包再登记发布；空则 pipeline 接口返回 503
# 也可用环境变量 NIUMA_PIPELINE_TOKEN 覆盖（勿把生产 token 提交进仓库）
# 也可用环境变量 NIUMA_PIPELINE_TOKEN（勿把生产 token 提交进仓库）
pipeline:
  token: ""

# 系统模型在 Ops「AI」页入库管理（接入点 / 模型目录），勿把上游密钥写进 yaml

# 日志
log:
  # debug | info | warn | error
  level: info
  # 是否同时输出到控制台
  to_console: true
  # 日志目录
  dir: ./logs
  # 单文件最大体积（MB），超出滚动
  max_size_mb: 100
  # 保留的滚动文件个数
  max_backups: 10
  # 保留天数
  max_age_days: 30

# 本地数据目录（sqlite 路径等）
data_dir: ./data
