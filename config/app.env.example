# 机密优先用环境变量，覆盖 app.yaml 同名字段。
# 复制为 app.env 后由进程管理器注入；app.env 已 gitignore。

# 至少 16 字符，禁止含 change-me / dev-niuma / example
NIUMA_JWT_SECRET=

# MySQL DSN；生产用内网地址，勿对公网开放 3306
# NIUMA_DB_DSN=niuma:SECRET@tcp(127.0.0.1:3306)/niuma_cloud?parseTime=true&charset=utf8mb4&loc=UTC

# SMTP 授权码（可替代 yaml smtp.password）
# NIUMA_SMTP_PASSWORD=

# 流水线共享密钥，至少 16 字符；GitHub Secret 用同一值
NIUMA_PIPELINE_TOKEN=

# 仅当库中还没有员工时用于种子；已有账号请在 Ops 改密
# NIUMA_STAFF_PASSWORD=

# 本地调试才允许样例 JWT；生产禁止
# NIUMA_ALLOW_INSECURE_DEV=1
