{
  "name": "niuma-cloud",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "NiuMa Cloud — Identity / Feedback / Updates / Admin Ops（工程根 /niuma）",
  "scripts": {
    "dev": "node script/dev.mjs",
    "dev:admin": "vite --config admin/vite.config.ts",
    "dev:server": "go run -C server ./cmd/server",
    "build": "vue-tsc --noEmit -p admin/tsconfig.json && vite build --config admin/vite.config.ts",
    "build:server": "go build -C server -o ../run/niuma-cloud.exe ./cmd/server",
    "build:all": "powershell -ExecutionPolicy Bypass -File script/build.ps1",
    "ci": "pnpm typecheck && pnpm test:server",
    "pack:release": "bash script/pack-release.sh",
    "start": "powershell -ExecutionPolicy Bypass -File script/start.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File script/stop.ps1",
    "restart": "powershell -ExecutionPolicy Bypass -File script/restart.ps1",
    "status": "powershell -ExecutionPolicy Bypass -File script/status.ps1",
    "test:server": "go test -C server ./...",
    "typecheck": "vue-tsc --noEmit -p admin/tsconfig.json"
  },
  "dependencies": {
    "@niuma/ui": "link:../niuma-ui",
    "axios": "^1.20.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vue-tsc": "^3.3.6"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "vue": "*"
      },
      "ignoreMissing": [
        "vue"
      ]
    }
  }
}
